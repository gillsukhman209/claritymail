{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/cron/morning-brief",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/cron/gmail-watch",
      "schedule": "0 9 * * *"
    }
  ]
}
